{
  "name": "etcd_http_requests_slow",
  "title": "Etcd HTTP requests slow",
  "severity": "warning",
  "description": "HTTP requests slowing down, 99th percentile is over 0.15s",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "etcd"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/etcd/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/etcd/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Etcd HTTP requests slow",
    "upstream_query": "histogram_quantile(0.99, rate(etcd_http_successful_duration_seconds_bucket[1m])) > 0.15",
    "upstream_description": "HTTP requests slowing down, 99th percentile is over 0.15s"
  },
  "stream_type": "metrics",
  "stream_name": "etcd_http_successful_duration_seconds_bucket",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "histogram_quantile(0.99, rate(etcd_http_successful_duration_seconds_bucket[1m]))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.15,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "This etcd_http_* metric is from the etcd v2 API and does not exist in etcd 3.x. Remove this rule if running etcd 3.x."
}
