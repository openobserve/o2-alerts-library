  "severity": "warning",
  "description": "GRPC requests slowing down, 99th percentile is over 0.15s",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "etcd"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/etcd/",
