    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/etcd/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Etcd GRPC requests slow",
    "upstream_query": "histogram_quantile(0.99, sum(rate(grpc_server_handling_seconds_bucket{grpc_method!=\"Defragment\", grpc_type=\"unary\"}[1m])) by (grpc_service, grpc_method, le)) > 0.15",
    "upstream_description": "GRPC requests slowing down, 99th percentile is over 0.15s"
  },
  "stream_type": "metrics",
  "stream_name": "grpc_server_handling_seconds_bucket",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "histogram_quantile(0.99, sum(rate(grpc_server_handling_seconds_bucket{grpc_method!=\"Defragment\", grpc_type=\"unary\"}[1m])) by (grpc_service, grpc_method, le))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.15,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
