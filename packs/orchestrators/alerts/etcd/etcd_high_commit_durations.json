{
  "name": "etcd_high_commit_durations",
  "title": "Etcd high commit durations",
  "severity": "warning",
  "description": "Etcd commit duration increasing, 99th percentile is over 0.25s",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "etcd"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/etcd/",
  "source": {
