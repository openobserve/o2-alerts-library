    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/etcd/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Etcd high commit durations",
    "upstream_query": "histogram_quantile(0.99, sum(rate(etcd_disk_backend_commit_duration_seconds_bucket[5m])) by (instance, le)) > 0.25",
    "upstream_description": "Etcd commit duration increasing, 99th percentile is over 0.25s"
  },
  "stream_type": "metrics",
  "stream_name": "etcd_disk_backend_commit_duration_seconds_bucket",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "histogram_quantile(0.99, sum(rate(etcd_disk_backend_commit_duration_seconds_bucket[5m])) by (instance, le))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.25,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
