{
  "name": "kubernetes_deployment_rollout_stuck",
  "title": "Kubernetes Deployment rollout stuck",
  "severity": "warning",
  "description": "Deployment rollout is not progressing, as reported by its Progressing=false condition.",
  "tags": [
    "awesome-prometheus-alerts",
    "kubernetes",
    "kubestate-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/kubernetes/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/kubernetes/",
    "exporter": "kubestate-exporter",
    "upstream_alert": "Kubernetes Deployment rollout stuck",
    "upstream_query": "kube_deployment_status_condition{condition=\"Progressing\",status=\"false\"} != 0",
    "upstream_description": "Deployment {{ $labels.namespace }}/{{ $labels.deployment }} rollout is not progressing, as reported by its Progressing=false condition."
  },
  "stream_type": "metrics",
  "stream_name": "kube_deployment_status_condition",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "kube_deployment_status_condition{condition=\"Progressing\",status=\"false\"}",
    "promql_condition": {
      "column": "value",
      "operator": "!=",
      "value": 0,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 10,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | namespace: {namespace} | deployment: {deployment} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
