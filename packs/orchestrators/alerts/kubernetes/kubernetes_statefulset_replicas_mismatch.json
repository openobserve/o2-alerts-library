    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/kubernetes/",
    "exporter": "kubestate-exporter",
    "upstream_alert": "Kubernetes StatefulSet replicas mismatch",
    "upstream_query": "kube_statefulset_status_replicas_ready != kube_statefulset_status_replicas",
    "upstream_description": "StatefulSet does not match the expected number of replicas.",
    "query_normalized": "The upstream threshold could not be lifted out of the expression (its outermost operator is and/or/unless, or it compares against another series), so the expression is normalised to 1 per matching series and the alert fires on any match. The observed value in the notification is therefore always 1."
  },
  "stream_type": "metrics",
  "stream_name": "kube_statefulset_status_replicas_ready",
  "is_real_time": false,
  "query_condition": {
