{
  "name": "kubernetes_statefulset_replicas_mismatch",
  "title": "Kubernetes StatefulSet replicas mismatch",
  "severity": "warning",
  "description": "StatefulSet does not match the expected number of replicas.",
  "tags": [
    "awesome-prometheus-alerts",
    "kubernetes",
    "kubestate-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/kubernetes/",
  "source": {
