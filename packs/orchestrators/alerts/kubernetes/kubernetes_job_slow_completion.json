    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 60,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | namespace: {namespace} | job_name: {job_name} | value: {value}",
