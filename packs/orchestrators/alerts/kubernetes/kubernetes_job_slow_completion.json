        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "kube_job_spec_completions - kube_job_status_succeeded - kube_job_status_failed",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0,
      "ignore_case": false
