    "exporter": "kubestate-exporter",
    "upstream_alert": "Kubernetes Pod not healthy",
    "upstream_query": "sum by (namespace, pod) (kube_pod_status_phase{phase=~\"Pending|Unknown|Failed\"}) > 0",
    "upstream_description": "Pod {{ $labels.namespace }}/{{ $labels.pod }} has been in a non-running state for longer than 15 minutes."
