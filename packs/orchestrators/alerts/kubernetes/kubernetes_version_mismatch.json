{
  "name": "kubernetes_version_mismatch",
  "title": "Kubernetes version mismatch",
  "severity": "warning",
  "description": "There are different semantic versions of Kubernetes components running simultaneously, which may indicate a partial or stalled cluster upgrade.",
  "tags": [
    "awesome-prometheus-alerts",
    "kubernetes",
    "kubestate-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/kubernetes/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/orchestrators/kubernetes/",
    "exporter": "kubestate-exporter",
    "upstream_alert": "Kubernetes version mismatch",
    "upstream_query": "count(count by (git_version) (label_replace(kubernetes_build_info, \"git_version\", \"$1\", \"git_version\", \"(v[0-9]*\\.[0-9]*\\.[0-9]*).*\"))) > 1",
    "upstream_description": "There are {{ $value }} different semantic versions of Kubernetes components running simultaneously, which may indicate a partial or stalled cluster upgrade.",
    "query_fixup": "The upstream expression above does not parse as PromQL; the corrected form this alert runs is in `query_condition.promql`. See QUERY_FIXUPS in scripts/import_awesome_prometheus_alerts.py."
  },
  "stream_type": "metrics",
  "stream_name": "kubernetes_build_info",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "count(count by (git_version) (label_replace(kubernetes_build_info, \"git_version\", \"$1\", \"git_version\", \"(v[0-9]*\\\\.[0-9]*\\\\.[0-9]*).*\")))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 10,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
