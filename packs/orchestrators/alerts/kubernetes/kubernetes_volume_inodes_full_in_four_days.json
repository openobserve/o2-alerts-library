{
  "name": "kubernetes_volume_inodes_full_in_four_days",
  "title": "Kubernetes Volume inodes full in four days",
  "severity": "critical",
  "description": "PersistentVolume claimed is expected to run out of free inodes within four days at the current rate.",
  "tags": [
    "awesome-prometheus-alerts",
    "kubernetes",
    "kubestate-exporter"
  ],
