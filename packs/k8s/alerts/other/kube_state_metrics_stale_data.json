{
  "name": "kube_state_metrics_stale_data",
  "org_id": "default",
  "stream_type": "metrics",
  "stream_name": "kube_persistentvolume_status_phase",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "count by(k8s_cluster)(kube_persistentvolume_status_phase{phase=~'Failed|Released'}) > 0 unless on(k8s_cluster) (count by(k8s_cluster)(kube_persistentvolume_info) > 0)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 60,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 1440,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "destinations": ["k8s_alert"],
  "context_attributes": {},
  "row_template": "*ClusterName:* {k8s_cluster} | KSM reports Failed/Released PVs that don't exist on cluster. Stale metrics — restart kube-state-metrics.",
  "row_template_type": "String",
  "description": "Info: kube-state-metrics reports PVs in Failed/Released state that don't exist in the actual cluster. Stale time series from previously deleted resources. Restart kube-state-metrics to flush. Runs every 60min with 24h silence.",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
