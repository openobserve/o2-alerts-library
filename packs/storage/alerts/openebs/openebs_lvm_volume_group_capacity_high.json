{
  "name": "openebs_lvm_volume_group_capacity_high",
  "title": "OpenEBS LVM volume group capacity high",
  "severity": "warning",
  "description": "OpenEBS LVM LocalPV volume group is using more than 90% of its capacity. Free up space or expand the volume group to avoid provisioning failures.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "openebs"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/storage/openebs/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/storage/openebs/",
    "exporter": "embedded-exporter",
    "upstream_alert": "OpenEBS LVM volume group capacity high",
    "upstream_query": "((lvm_vg_total_size_bytes - lvm_vg_free_size_bytes) / lvm_vg_total_size_bytes) * 100 > 90",
    "upstream_description": "OpenEBS LVM LocalPV volume group {{ $labels.instance }} is using more than 90% of its capacity ({{ $value }}%). Free up space or expand the volume group to avoid provisioning failures."
  },
  "stream_type": "metrics",
  "stream_name": "lvm_vg_total_size_bytes",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "((lvm_vg_total_size_bytes - lvm_vg_free_size_bytes) / lvm_vg_total_size_bytes) * 100",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 90,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
