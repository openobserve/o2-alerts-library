{
  "name": "spark_executor_high_gc_time",
  "title": "Spark executor high GC time",
  "severity": "warning",
  "description": "Spark executor is spending too much time in GC.",
  "tags": [
    "apache-spark",
    "awesome-prometheus-alerts",
    "spark-prometheus"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/data-engineering/apache-spark/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/data-engineering/apache-spark/",
    "exporter": "spark-prometheus",
    "upstream_alert": "Spark executor high GC time",
    "upstream_query": "metrics_executor_totalGCTime_seconds_total / metrics_executor_totalDuration > 0.1 and metrics_executor_totalDuration > 0",
    "upstream_description": "Spark executor {{ $labels.executor_id }} in {{ $labels.application_name }} is spending too much time in GC.",
    "query_normalized": "The upstream threshold could not be lifted out of the expression (its outermost operator is and/or/unless, or it compares against another series), so the expression is normalised to 1 per matching series and the alert fires on any match. The observed value in the notification is therefore always 1."
  },
  "stream_type": "metrics",
  "stream_name": "metrics_executor_totalGCTime_seconds_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "(metrics_executor_totalGCTime_seconds_total / metrics_executor_totalDuration > 0.1 and metrics_executor_totalDuration > 0) * 0 + 1",
    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | executor_id: {executor_id} | application_name: {application_name}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Fires when more than 10% of executor time is spent in garbage collection.\nThis metric comes from the PrometheusResource endpoint (/metrics/executors/prometheus/)."
}
