  "severity": "warning",
  "description": "Flink TaskManager is spending more than 10% of time in garbage collection.",
  "tags": [
    "apache-flink",
    "awesome-prometheus-alerts",
    "flink-prometheus-reporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/data-engineering/apache-flink/",
  "source": {
