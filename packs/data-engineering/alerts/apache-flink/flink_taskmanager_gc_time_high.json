    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/data-engineering/apache-flink/",
    "exporter": "flink-prometheus-reporter",
    "upstream_alert": "Flink TaskManager GC time high",
    "upstream_query": "deriv(flink_taskmanager_Status_JVM_GarbageCollector_All_Time[5m]) > 100",
    "upstream_description": "Flink TaskManager {{ $labels.instance }} is spending more than 10% of time in garbage collection."
  },
  "stream_type": "metrics",
  "stream_name": "flink_taskmanager_Status_JVM_GarbageCollector_All_Time",
  "is_real_time": false,
  "query_condition": {
