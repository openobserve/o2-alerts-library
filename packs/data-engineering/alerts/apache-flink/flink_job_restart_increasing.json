    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/data-engineering/apache-flink/",
    "exporter": "flink-prometheus-reporter",
    "upstream_alert": "Flink job restart increasing",
    "upstream_query": "delta(flink_jobmanager_job_numRestarts[5m]) > 1",
    "upstream_description": "Flink job {{ $labels.job_name }} has restarted {{ $value }} times in the last 5 minutes."
  },
  "stream_type": "metrics",
  "stream_name": "flink_jobmanager_job_numRestarts",
  "is_real_time": false,
  "query_condition": {
