{
  "name": "flink_job_restart_increasing",
  "title": "Flink job restart increasing",
  "severity": "warning",
  "description": "Flink job has restarted times in the last 5 minutes.",
  "tags": [
    "apache-flink",
    "awesome-prometheus-alerts",
    "flink-prometheus-reporter"
  ],
