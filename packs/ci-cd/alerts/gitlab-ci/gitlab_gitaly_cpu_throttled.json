{
  "name": "gitlab_gitaly_cpu_throttled",
  "title": "GitLab Gitaly CPU throttled",
  "severity": "warning",
  "description": "Gitaly processes are being CPU throttled by cgroups.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitaly",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
    "exporter": "gitaly",
    "upstream_alert": "GitLab Gitaly CPU throttled",
    "upstream_query": "rate(gitaly_cgroup_cpu_cfs_throttled_seconds_total[5m]) > 0.1",
    "upstream_description": "Gitaly processes on {{ $labels.instance }} are being CPU throttled by cgroups."
  },
  "stream_type": "metrics",
  "stream_name": "gitaly_cgroup_cpu_cfs_throttled_seconds_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "rate(gitaly_cgroup_cpu_cfs_throttled_seconds_total[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Brief throttling spikes are normal. Threshold of 0.1s/s (10% of CPU time throttled) filters out transient noise."
}
