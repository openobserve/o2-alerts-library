{
  "name": "gitlab_gitaly_authentication_failures",
  "title": "GitLab Gitaly authentication failures",
  "severity": "warning",
  "description": "Gitaly has authentication failures.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitaly",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
    "exporter": "gitaly",
    "upstream_alert": "GitLab Gitaly authentication failures",
    "upstream_query": "increase(gitaly_authentications_total{status=\"denied\"}[5m]) > 3",
    "upstream_description": "Gitaly on {{ $labels.instance }} has authentication failures ({{ $value }})."
  },
  "stream_type": "metrics",
  "stream_name": "gitaly_authentications_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "increase(gitaly_authentications_total{status=\"denied\"}[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 3,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
