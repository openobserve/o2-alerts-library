{
  "name": "gitlab_high_memory_usage",
  "title": "GitLab high memory usage",
  "severity": "warning",
  "description": "GitLab process is using RSS memory.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitlab-built-in-exporter",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
    "exporter": "gitlab-built-in-exporter",
    "upstream_alert": "GitLab high memory usage",
    "upstream_query": "process_resident_memory_bytes{job=~\".*gitlab.*\"} > 2e+9",
    "upstream_description": "GitLab process on {{ $labels.instance }} is using {{ $value | humanize1024 }}B of RSS memory."
  },
  "stream_type": "metrics",
  "stream_name": "process_resident_memory_bytes",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "process_resident_memory_bytes{job=~\".*gitlab.*\"}",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 2000000000,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 10,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Threshold of 2GB may need adjustment based on your instance size.\nHigh memory usage can lead to OOM kills and service disruptions."
}
