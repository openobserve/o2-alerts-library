{
  "name": "gitlab_ruby_heap_fragmentation",
  "title": "GitLab Ruby heap fragmentation",
  "severity": "warning",
  "description": "GitLab Ruby heap fragmentation is. High fragmentation wastes memory.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitlab-built-in-exporter",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
    "exporter": "gitlab-built-in-exporter",
    "upstream_alert": "GitLab Ruby heap fragmentation",
    "upstream_query": "ruby_gc_stat_ext_heap_fragmentation{job=~\".*gitlab.*\"} > 0.5",
    "upstream_description": "GitLab Ruby heap fragmentation on {{ $labels.instance }} is {{ $value }}. High fragmentation wastes memory."
  },
  "stream_type": "metrics",
  "stream_name": "ruby_gc_stat_ext_heap_fragmentation",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "ruby_gc_stat_ext_heap_fragmentation{job=~\".*gitlab.*\"}",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.5,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Heap fragmentation above 50% means a significant amount of memory is wasted.\nA Puma worker restart may help reclaim memory."
}
