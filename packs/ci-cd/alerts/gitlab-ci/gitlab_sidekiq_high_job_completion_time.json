{
  "name": "gitlab_sidekiq_high_job_completion_time",
  "title": "GitLab Sidekiq high job completion time",
  "severity": "warning",
  "description": "GitLab Sidekiq job p95 completion time is above 5 minutes.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitlab-built-in-exporter",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
    "exporter": "gitlab-built-in-exporter",
    "upstream_alert": "GitLab Sidekiq high job completion time",
    "upstream_query": "histogram_quantile(0.95, sum(rate(sidekiq_jobs_completion_seconds_bucket[5m])) by (le, worker)) > 300",
    "upstream_description": "GitLab Sidekiq job p95 completion time on {{ $labels.instance }} is above 5 minutes ({{ $value | humanizeDuration }}).",
    "labels_dropped": "The upstream annotation interpolates instance, but this expression aggregates those labels away, so they are not in row_template — they would render as literal placeholders."
  },
  "stream_type": "metrics",
  "stream_name": "sidekiq_jobs_completion_seconds_bucket",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "histogram_quantile(0.95, sum(rate(sidekiq_jobs_completion_seconds_bucket[5m])) by (le, worker))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 300,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 10,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "This metric requires the emit_sidekiq_histogram_metrics feature flag to be enabled."
}
