{
  "name": "gitlab_ruby_threads_saturated",
  "title": "GitLab Ruby threads saturated",
  "severity": "warning",
  "description": "GitLab running threads have exceeded the expected maximum.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitlab-built-in-exporter",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
