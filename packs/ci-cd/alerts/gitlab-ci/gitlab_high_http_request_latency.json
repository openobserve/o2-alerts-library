{
  "name": "gitlab_high_http_request_latency",
  "title": "GitLab high HTTP request latency",
  "severity": "warning",
  "description": "GitLab p95 HTTP request latency is above 10 seconds.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitlab-built-in-exporter",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
    "exporter": "gitlab-built-in-exporter",
    "upstream_alert": "GitLab high HTTP request latency",
    "upstream_query": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) > 10",
    "upstream_description": "GitLab p95 HTTP request latency on {{ $labels.instance }} is above 10 seconds.",
    "labels_dropped": "The upstream annotation interpolates instance, but this expression aggregates those labels away, so they are not in row_template — they would render as literal placeholders."
  },
  "stream_type": "metrics",
  "stream_name": "http_request_duration_seconds_bucket",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 10,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Threshold of 10s may need adjustment based on your instance size and workload."
}
