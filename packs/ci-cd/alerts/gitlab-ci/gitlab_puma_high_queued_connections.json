{
  "name": "gitlab_puma_high_queued_connections",
  "title": "GitLab Puma high queued connections",
  "severity": "warning",
  "description": "GitLab Puma has queued connections. Requests are waiting for an available worker thread.",
  "tags": [
    "awesome-prometheus-alerts",
    "gitlab-built-in-exporter",
    "gitlab-ci"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/gitlab-ci/",
    "exporter": "gitlab-built-in-exporter",
    "upstream_alert": "GitLab Puma high queued connections",
    "upstream_query": "puma_queued_connections > 5",
    "upstream_description": "GitLab Puma has {{ $value }} queued connections on {{ $labels.instance }}. Requests are waiting for an available worker thread."
  },
  "stream_type": "metrics",
  "stream_name": "puma_queued_connections",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "puma_queued_connections",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 5,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Queued connections indicate Puma workers are saturated.\nConsider increasing puma['worker_processes'] or puma['max_threads'] in gitlab.rb."
}
