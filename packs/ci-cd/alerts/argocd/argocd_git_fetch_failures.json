{
  "name": "argocd_git_fetch_failures",
  "title": "ArgoCD git fetch failures",
  "severity": "warning",
  "description": "ArgoCD is failing to fetch git repository, which will block application sync and manifest generation.",
  "tags": [
    "argocd",
    "awesome-prometheus-alerts",
    "embedded-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/argocd/",
