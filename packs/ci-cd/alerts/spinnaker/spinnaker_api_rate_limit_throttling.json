{
  "name": "spinnaker_api_rate_limit_throttling",
  "title": "Spinnaker API rate limit throttling",
  "severity": "warning",
  "description": "Gate is actively throttling API requests.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "spinnaker"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/spinnaker/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/spinnaker/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Spinnaker API rate limit throttling",
    "upstream_query": "rate(rateLimitThrottling_total[5m]) > 0.05",
    "upstream_description": "Gate is actively throttling API requests on {{ $labels.instance }} ({{ $value }} throttled requests per second)."
  },
  "stream_type": "metrics",
  "stream_name": "rateLimitThrottling_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "rate(rateLimitThrottling_total[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.05,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "0.05/s is a rough default; throttling volume correlates with your configured rate limit and client request volume — adjust based on your workload."
}
