{
  "name": "aws_rds_high_database_connections",
  "title": "AWS RDS high database connections",
  "severity": "warning",
  "description": "RDS instance has active connections.",
  "tags": [
    "awesome-prometheus-alerts",
    "aws-cloudwatch",
    "prometheus-cloudwatch-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/aws-cloudwatch/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/aws-cloudwatch/",
    "exporter": "prometheus-cloudwatch-exporter",
    "upstream_alert": "AWS RDS high database connections",
    "upstream_query": "aws_rds_database_connections_average offset 10m > 100",
    "upstream_description": "RDS instance {{ $labels.dbinstance_identifier }} has {{ $value }} active connections."
  },
  "stream_type": "metrics",
  "stream_name": "aws_rds_database_connections_average",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "aws_rds_database_connections_average offset 10m",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 100,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | dbinstance_identifier: {dbinstance_identifier} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "The threshold depends on the RDS instance class. Adjust based on your\ninstance type's max_connections parameter."
}
