{
  "name": "cloudwatch_api_high_request_rate",
  "title": "CloudWatch API high request rate",
  "severity": "warning",
  "description": "CloudWatch exporter is making API calls per minute to namespace. This can lead to high AWS costs.",
  "tags": [
    "awesome-prometheus-alerts",
    "aws-cloudwatch",
    "prometheus-cloudwatch-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/aws-cloudwatch/",
  "source": {
    "project": "awesome-prometheus-alerts",
