{
  "name": "aws_ec2_high_cpu_utilization",
  "title": "AWS EC2 high CPU utilization",
  "severity": "warning",
  "description": "EC2 instance CPU utilization is above 90%.",
  "tags": [
    "awesome-prometheus-alerts",
    "aws-cloudwatch",
    "prometheus-cloudwatch-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/aws-cloudwatch/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/aws-cloudwatch/",
    "exporter": "prometheus-cloudwatch-exporter",
    "upstream_alert": "AWS EC2 high CPU utilization",
    "upstream_query": "aws_ec2_cpuutilization_average offset 10m > 90",
    "upstream_description": "EC2 instance {{ $labels.instance_id }} CPU utilization is above 90% ({{ $value }}%)."
  },
  "stream_type": "metrics",
  "stream_name": "aws_ec2_cpuutilization_average",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "aws_ec2_cpuutilization_average offset 10m",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 90,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance_id: {instance_id} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Requires EC2 CPUUtilization metric configured in the CloudWatch exporter."
}
