{
  "name": "aws_sqs_queue_messages_visible",
  "title": "AWS SQS queue messages visible",
  "severity": "warning",
  "description": "SQS queue has messages waiting to be processed.",
  "tags": [
    "awesome-prometheus-alerts",
    "aws-cloudwatch",
    "prometheus-cloudwatch-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/aws-cloudwatch/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/aws-cloudwatch/",
    "exporter": "prometheus-cloudwatch-exporter",
    "upstream_alert": "AWS SQS queue messages visible",
    "upstream_query": "aws_sqs_approximate_number_of_messages_visible_average offset 10m > 1000",
    "upstream_description": "SQS queue {{ $labels.queue_name }} has {{ $value }} messages waiting to be processed."
  },
  "stream_type": "metrics",
  "stream_name": "aws_sqs_approximate_number_of_messages_visible_average",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "aws_sqs_approximate_number_of_messages_visible_average offset 10m",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 1000,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 10,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | queue_name: {queue_name} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Requires SQS ApproximateNumberOfMessagesVisible metric. The threshold of 1000\nis a rough default. Adjust based on your expected queue depth."
}
