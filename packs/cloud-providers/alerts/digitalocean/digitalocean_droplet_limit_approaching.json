{
  "name": "digitalocean_droplet_limit_approaching",
  "title": "DigitalOcean droplet limit approaching",
  "severity": "warning",
  "description": "DigitalOcean account is using a high percentage of its droplet quota.",
  "tags": [
    "awesome-prometheus-alerts",
    "digitalocean",
    "digitalocean-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/digitalocean/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/cloud-providers/digitalocean/",
    "exporter": "digitalocean-exporter",
    "upstream_alert": "DigitalOcean droplet limit approaching",
    "upstream_query": "(count(digitalocean_droplet_up) / digitalocean_account_droplet_limit) * 100 > 80 and digitalocean_account_droplet_limit > 0",
    "upstream_description": "DigitalOcean account is using {{ $value }}% of its droplet quota.",
    "query_normalized": "The upstream threshold could not be lifted out of the expression (its outermost operator is and/or/unless, or it compares against another series), so the expression is normalised to 1 per matching series and the alert fires on any match. The observed value in the notification is therefore always 1."
  },
  "stream_type": "metrics",
  "stream_name": "digitalocean_droplet_up",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "((count(digitalocean_droplet_up) / digitalocean_account_droplet_limit) * 100 > 80 and digitalocean_account_droplet_limit > 0) * 0 + 1",
    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}*",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Fires when more than 80% of the account's droplet limit is in use."
}
