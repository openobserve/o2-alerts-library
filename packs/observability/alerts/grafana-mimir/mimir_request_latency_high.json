{
  "name": "mimir_request_latency_high",
  "title": "Mimir request latency high",
  "severity": "warning",
  "description": "Mimir is experiencing a p99 request latency.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "grafana-mimir"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-mimir/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-mimir/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Mimir request latency high",
    "upstream_query": "histogram_quantile(0.99, sum by (job, route, le) (rate(cortex_request_duration_seconds_bucket{route!~\"ready|debug_pprof\"}[5m]))) > 2.5",
    "upstream_description": "Mimir {{ $labels.job }} {{ $labels.route }} is experiencing a p99 request latency of {{ $value }}s."
  },
  "stream_type": "metrics",
  "stream_name": "cortex_request_duration_seconds_bucket",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "histogram_quantile(0.99, sum by (job, route, le) (rate(cortex_request_duration_seconds_bucket{route!~\"ready|debug_pprof\"}[5m])))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 2.5,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | job: {job} | route: {route} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "2.5s threshold is a rough default; acceptable latency varies by route and your SLO — adjust based on your baseline."
}
