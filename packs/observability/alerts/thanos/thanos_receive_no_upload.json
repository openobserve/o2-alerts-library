{
  "name": "thanos_receive_no_upload",
  "title": "Thanos Receive No Upload",
  "severity": "critical",
  "description": "Thanos Receive has not uploaded latest data to object storage.",
  "tags": [
    "awesome-prometheus-alerts",
    "thanos",
    "thanos-receiver"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/thanos/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/thanos/",
    "exporter": "thanos-receiver",
    "upstream_alert": "Thanos Receive No Upload",
    "upstream_query": "(up{job=~\".*thanos-receive.*\"} - 1) + on (job, instance) (sum by (job, instance) (increase(thanos_shipper_uploads_total{job=~\".*thanos-receive.*\"}[3h])) == 0)",
    "upstream_description": "Thanos Receive {{$labels.instance}} has not uploaded latest data to object storage.",
    "period_clamped_from": "Upstream `for` is 3h (180 minutes); the evaluation window is capped at 60 minutes. Widen trigger_condition.period if you want the full upstream window.",
    "query_normalized": "The upstream threshold could not be lifted out of the expression (its outermost operator is and/or/unless, or it compares against another series), so the expression is normalised to 1 per matching series and the alert fires on any match. The observed value in the notification is therefore always 1."
  },
  "stream_type": "metrics",
  "stream_name": "up",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "((up{job=~\".*thanos-receive.*\"} - 1) + on (job, instance) (sum by (job, instance) (increase(thanos_shipper_uploads_total{job=~\".*thanos-receive.*\"}[3h])) == 0)) * 0 + 1",
    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 60,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
