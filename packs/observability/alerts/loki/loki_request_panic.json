{
  "name": "loki_request_panic",
  "title": "Loki request panic",
  "severity": "critical",
  "description": "Is experiencing panic(s) in the last 5 minutes.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "loki"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/loki/",
  "source": {
    "project": "awesome-prometheus-alerts",
