{
  "name": "loki_too_many_compactors_running",
  "title": "Loki too many compactors running",
  "severity": "warning",
  "description": "More than one Loki compactor is running in cluster; the compactor must run as a singleton, or index compaction and retention can be duplicated or corrupted.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "loki"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/loki/",
