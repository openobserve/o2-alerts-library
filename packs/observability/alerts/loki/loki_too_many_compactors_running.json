    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/loki/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Loki too many compactors running",
    "upstream_query": "sum(loki_boltdb_shipper_compactor_running) by (cluster) > 1",
    "upstream_description": "More than one Loki compactor is running in cluster {{ $labels.cluster }}; the compactor must run as a singleton, or index compaction and retention can be duplicated or corrupted."
  },
  "stream_type": "metrics",
  "stream_name": "loki_boltdb_shipper_compactor_running",
  "is_real_time": false,
