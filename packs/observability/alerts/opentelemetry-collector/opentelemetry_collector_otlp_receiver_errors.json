    "upstream_alert": "OpenTelemetry Collector OTLP receiver errors",
    "upstream_query": "rate(otelcol_receiver_accepted_spans{receiver=~\"otlp\"}[5m]) == 0 and rate(otelcol_receiver_refused_spans{receiver=~\"otlp\"}[5m]) > 0",
