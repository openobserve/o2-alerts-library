{
  "name": "grafana_alloy_unhealthy_components",
  "title": "Grafana Alloy unhealthy components",
  "severity": "warning",
  "description": "One or more Alloy pipeline components (receivers, exporters, processors, discovery, etc.) under job are reporting a non-healthy status, even though the Alloy process itself is still running.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "grafana-alloy"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-alloy/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-alloy/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Grafana Alloy unhealthy components",
    "upstream_query": "sum by (job) (alloy_component_controller_running_components{health_type!=\"healthy\"}) > 0",
    "upstream_description": "One or more Alloy pipeline components (receivers, exporters, processors, discovery, etc.) under job {{ $labels.job }} are reporting a non-healthy status, even though the Alloy process itself is still running."
  },
  "stream_type": "metrics",
  "stream_name": "alloy_component_controller_running_components",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
