{
  "name": "grafana_alloy_cluster_node_unhealthy",
  "title": "Grafana Alloy cluster node unhealthy",
  "severity": "warning",
  "description": "Alloy node under job is reporting a gossip protocol health score above 0, indicating clustering issues that may prevent the node from properly participating in the cluster.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "grafana-alloy"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-alloy/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-alloy/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Grafana Alloy cluster node unhealthy",
    "upstream_query": "cluster_node_gossip_health_score > 0",
    "upstream_description": "Alloy node under job {{ $labels.job }} is reporting a gossip protocol health score above 0, indicating clustering issues that may prevent the node from properly participating in the cluster."
  },
  "stream_type": "metrics",
  "stream_name": "cluster_node_gossip_health_score",
  "is_real_time": false,
  "query_condition": {
