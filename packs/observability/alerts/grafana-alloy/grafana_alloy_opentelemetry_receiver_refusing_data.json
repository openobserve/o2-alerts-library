{
  "name": "grafana_alloy_opentelemetry_receiver_refusing_data",
  "title": "Grafana Alloy OpenTelemetry receiver refusing data",
  "severity": "critical",
  "description": "The OpenTelemetry receiver in Alloy under job has a success rate below 95% for pushing spans, metrics, or logs into the pipeline, meaning telemetry data is being dropped, possibly due to limits imposed by otelcol.processor.memory_limiter.",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "grafana-alloy"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-alloy/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/observability/grafana-alloy/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Grafana Alloy OpenTelemetry receiver refusing data",
    "upstream_query": "(1 - (sum by (job) (rate({__name__=~\"otelcol_receiver_refused_(spans|metric_points|log_records)_total\"}[1m])) / (sum by (job) (rate({__name__=~\"otelcol_receiver_refused_(spans|metric_points|log_records)_total\"}[1m])) + sum by (job) (rate({__name__=~\"otelcol_receiver_accepted_(spans|metric_points|log_records)_total\"}[1m]))))) < 0.95",
    "upstream_description": "The OpenTelemetry receiver in Alloy under job {{ $labels.job }} has a success rate below 95% for pushing spans, metrics, or logs into the pipeline, meaning telemetry data is being dropped, possibly due to limits imposed by otelcol.processor.memory_limiter."
  },
  "stream_type": "metrics",
  "stream_name": "otelcol_receiver_refused_spans_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "1 - (sum by (job) (rate({__name__=~\"otelcol_receiver_refused_(spans|metric_points|log_records)_total\"}[1m])) / (sum by (job) (rate({__name__=~\"otelcol_receiver_refused_(spans|metric_points|log_records)_total\"}[1m])) + sum by (job) (rate({__name__=~\"otelcol_receiver_accepted_(spans|metric_points|log_records)_total\"}[1m]))))",
    "promql_condition": {
      "column": "value",
      "operator": "<",
