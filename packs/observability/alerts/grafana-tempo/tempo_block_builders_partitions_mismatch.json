    "exporter": "embedded-exporter",
    "upstream_alert": "Tempo block builders partitions mismatch",
    "upstream_query": "max by (job) (tempo_partition_ring_partitions{name=\"livestore-partitions\", state=~\"Active|Inactive\"}) > sum by (job) (tempo_block_builder_owned_partitions)",
