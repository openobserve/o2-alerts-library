    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
