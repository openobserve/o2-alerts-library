    "upstream_alert": "Istio Pilot high push error rate",
    "upstream_query": "sum(rate(pilot_xds_push_errors[1m])) / sum(rate(pilot_xds_pushes[1m])) * 100 > 5 and sum(rate(pilot_xds_pushes[1m])) > 0",
    "upstream_description": "Number of Istio Pilot push errors is too high (> 5%). Envoy sidecars might have outdated configuration.",
