    },
    "sql": null,
    "promql": "(sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[3m])) by (instance) / sum(rate(caddy_http_request_duration_seconds_count[3m])) by (instance) * 100 > 5 and sum(rate(caddy_http_request_duration_seconds_count[3m])) by (instance) > 0) * 0 + 1",
    "promql_condition": {
      "column": "value",
