{
  "name": "haproxy_backend_max_active_session_80",
  "title": "HAProxy backend max active session > 80%",
  "severity": "warning",
  "description": "Session limit from backend reached 80% of limit - a high percentage",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter-v2",
    "haproxy"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/proxies-load-balancers-and-service-meshes/haproxy/",
