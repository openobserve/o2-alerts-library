{
  "name": "postgresql_too_many_connections_otel",
  "title": "PostgreSQL too many connections",
  "severity": "warning",
  "description": "PostgreSQL has used more than 80% of its max_connections for 10 minutes. New clients will be refused when it reaches 100%. Only connections to the databases the collector monitors are counted.",
  "tags": [
    "otel-collector",
    "postgresql",
    "postgresql-receiver",
    "connections"
  ],
  "alert_type": "scheduled",
  "stream_type": "metrics",
  "stream_name": "postgresql_backends",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "sum by (service_instance_id) (min_over_time(postgresql_backends[10m])) / on (service_instance_id) max by (service_instance_id) (postgresql_connection_max)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.8,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {service_instance_id} | used: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
