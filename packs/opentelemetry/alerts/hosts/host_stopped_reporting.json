{
  "name": "host_stopped_reporting",
  "title": "Host stopped reporting",
  "severity": "critical",
  "description": "A host sent metrics 15 minutes ago and has sent none since. The host may be down, or its OpenTelemetry Collector may have stopped. A host removed on purpose fires this alert once.",
  "tags": [
    "otel-collector",
    "hosts",
    "hostmetrics"
  ],
  "alert_type": "scheduled",
  "stream_type": "metrics",
  "stream_name": "system_cpu_load_average_1m",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "count by (host_name) (system_cpu_load_average_1m offset 15m) unless count by (host_name) (system_cpu_load_average_1m)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | host: {host_name}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
