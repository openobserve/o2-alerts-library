{
  "name": "host_high_cpu_load_otel",
  "title": "Host high CPU usage",
  "severity": "warning",
  "description": "A host's CPUs have been more than 90% busy for 15 minutes without a break. Hosts that run batch work at full CPU on purpose can trigger this alert.",
  "tags": [
    "otel-collector",
    "hosts",
    "hostmetrics",
    "cpu"
  ],
  "alert_type": "scheduled",
  "stream_type": "metrics",
  "stream_name": "system_cpu_utilization",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "1 - avg by (host_name) (max_over_time(system_cpu_utilization{state=\"idle\"}[15m]))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.9,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | host: {host_name} | busy: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
