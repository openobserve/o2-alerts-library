{
  "name": "host_out_of_disk_space_otel",
  "title": "Host out of disk space",
  "severity": "critical",
  "description": "A writable filesystem on a host has been more than 95% full for 10 minutes. Temporary, container overlay and snap filesystems are ignored.",
  "tags": [
    "otel-collector",
    "hosts",
    "hostmetrics"
  ],
  "alert_type": "scheduled",
  "stream_type": "metrics",
  "stream_name": "system_filesystem_utilization",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "max by (host_name, device, mountpoint) (min_over_time(system_filesystem_utilization{mode=\"rw\", type!~\"tmpfs|devtmpfs|devfs|overlay|squashfs|iso9660|nsfs|proc|sysfs|autofs|fuse.*\", mountpoint!~\"/(dev|proc|sys|run|snap|var/lib/docker|var/lib/kubelet)(/.*)?\"}[10m]))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.95,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | host: {host_name} | mount: {mountpoint} | used: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
