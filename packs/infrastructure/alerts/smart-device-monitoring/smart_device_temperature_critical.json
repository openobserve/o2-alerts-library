    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/s-m-a-r-t-device-monitoring/",
    "exporter": "smartctl-exporter",
    "upstream_alert": "SMART device temperature critical",
    "upstream_query": "(max_over_time(smartctl_device_temperature{temperature_type=\"current\"} [5m]) unless on (instance, device) smartctl_device_temperature{temperature_type=\"drive_trip\"}) > 70",
    "upstream_description": "Device temperature critical on {{ $labels.instance }} drive {{ $labels.device }} over 70°C"
  },
  "stream_type": "metrics",
  "stream_name": "smartctl_device_temperature",
  "is_real_time": false,
  "query_condition": {
