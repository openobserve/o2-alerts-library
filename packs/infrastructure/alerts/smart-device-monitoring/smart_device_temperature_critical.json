{
  "name": "smart_device_temperature_critical",
  "title": "SMART device temperature critical",
  "severity": "critical",
  "description": "Device temperature critical drive over 70°C",
  "tags": [
    "awesome-prometheus-alerts",
    "smart-device-monitoring",
    "smartctl-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/s-m-a-r-t-device-monitoring/",
  "source": {
