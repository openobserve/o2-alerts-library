    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/windows-server/",
    "exporter": "windows-exporter",
    "upstream_alert": "Windows Server memory Usage",
    "upstream_query": "100 - ((windows_memory_physical_free_bytes / windows_memory_physical_total_bytes) * 100) > 90",
    "upstream_description": "Memory usage is more than 90%"
  },
  "stream_type": "metrics",
  "stream_name": "windows_memory_physical_free_bytes",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "100 - ((windows_memory_physical_free_bytes / windows_memory_physical_total_bytes) * 100)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 90,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
