{
  "name": "windows_server_disk_drive_status",
  "title": "Windows Server disk drive Status",
  "severity": "critical",
  "description": "Physical disk is reporting a status other than OK, which can indicate an imminent physical disk failure or a degraded array member.",
  "tags": [
    "awesome-prometheus-alerts",
    "windows-exporter",
    "windows-server"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/windows-server/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/windows-server/",
    "exporter": "windows-exporter",
    "upstream_alert": "Windows Server disk drive Status",
    "upstream_query": "windows_disk_drive_status{status=\"OK\"} != 1",
    "upstream_description": "Physical disk {{ $labels.name }} on {{ $labels.instance }} is reporting a status other than OK, which can indicate an imminent physical disk failure or a degraded array member."
  },
  "stream_type": "metrics",
  "stream_name": "windows_disk_drive_status",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "windows_disk_drive_status{status=\"OK\"}",
    "promql_condition": {
      "column": "value",
      "operator": "!=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | name: {name} | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
