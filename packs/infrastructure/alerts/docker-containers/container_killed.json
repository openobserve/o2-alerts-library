{
  "name": "container_killed",
  "title": "Container killed",
  "severity": "warning",
  "description": "A container has disappeared",
  "tags": [
    "awesome-prometheus-alerts",
    "docker-containers",
    "google-cadvisor"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/docker-containers/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/docker-containers/",
    "exporter": "google-cadvisor",
    "upstream_alert": "Container killed",
    "upstream_query": "time() - container_last_seen > 60",
    "upstream_description": "A container has disappeared"
  },
  "stream_type": "metrics",
  "stream_name": "container_last_seen",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "time() - container_last_seen",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 60,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "This rule can be very noisy in dynamic infra with legitimate container start/stop/deployment."
}
