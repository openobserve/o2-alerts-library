{
  "name": "virtual_machine_memory_critical",
  "title": "Virtual Machine Memory Critical",
  "severity": "critical",
  "description": "High memory usage: a high percentage",
  "tags": [
    "awesome-prometheus-alerts",
    "pryorda-vmware-exporter",
    "vmware"
  ],
