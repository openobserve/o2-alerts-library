{
  "name": "outdated_snapshots",
  "title": "Outdated Snapshots",
  "severity": "warning",
  "description": "Outdated snapshots: days",
  "tags": [
    "awesome-prometheus-alerts",
    "pryorda-vmware-exporter",
    "vmware"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/vmware/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/vmware/",
    "exporter": "pryorda-vmware-exporter",
    "upstream_alert": "Outdated Snapshots",
    "upstream_query": "(time() - vmware_vm_snapshot_timestamp_seconds) / (60 * 60 * 24) >= 7",
    "upstream_description": "Outdated snapshots on {{ $labels.instance }}: {{ $value | printf \"%.0f\"}} days"
  },
  "stream_type": "metrics",
  "stream_name": "vmware_vm_snapshot_timestamp_seconds",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "(time() - vmware_vm_snapshot_timestamp_seconds) / (60 * 60 * 24)",
    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 7,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "7 days is a rough default; how long a snapshot should live depends on your backup/retention policy — adjust based on your workflow."
}
