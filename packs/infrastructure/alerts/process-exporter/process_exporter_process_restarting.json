{
  "name": "process_exporter_process_restarting",
  "title": "Process exporter process restarting",
  "severity": "info",
  "description": "Process group has restarted (oldest process start time changed).",
  "tags": [
    "awesome-prometheus-alerts",
    "process-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/process-exporter/",
  "source": {
