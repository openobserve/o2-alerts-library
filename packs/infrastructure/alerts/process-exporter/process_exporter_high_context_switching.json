{
  "name": "process_exporter_high_context_switching",
  "title": "Process exporter high context switching",
  "severity": "warning",
  "description": "Process group has a high rate of context switches.",
  "tags": [
    "awesome-prometheus-alerts",
    "process-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/process-exporter/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/process-exporter/",
    "exporter": "process-exporter",
    "upstream_alert": "Process exporter high context switching",
    "upstream_query": "rate(namedprocess_namegroup_context_switches_total{ctxswitchtype=\"voluntary\"}[5m]) > 50000",
    "upstream_description": "Process group {{ $labels.groupname }} has a high rate of context switches ({{ $value }}/s). (instance {{ $labels.instance }})"
  },
  "stream_type": "metrics",
  "stream_name": "namedprocess_namegroup_context_switches_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "rate(namedprocess_namegroup_context_switches_total{ctxswitchtype=\"voluntary\"}[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 50000,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | groupname: {groupname} | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "Filters to voluntary switches only — involuntary switches are normal under CPU contention. Threshold of 50000/s is a rough default. Adjust based on workload."
}
