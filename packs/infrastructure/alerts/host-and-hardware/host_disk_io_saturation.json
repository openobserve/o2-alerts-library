{
  "name": "host_disk_io_saturation",
  "title": "Host disk IO saturation",
  "severity": "warning",
  "description": "Weighted disk I/O time indicates a growing request queue depth (similar to iostat's aqu-sz), a distinct saturation symptom from raw disk busy-time utilization.",
  "tags": [
    "awesome-prometheus-alerts",
    "host-and-hardware",
    "node-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/host-and-hardware/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/host-and-hardware/",
    "exporter": "node-exporter",
    "upstream_alert": "Host disk IO saturation",
    "upstream_query": "rate(node_disk_io_time_weighted_seconds_total[5m]) > 10",
    "upstream_description": "Weighted disk I/O time on {{ $labels.instance }} indicates a growing request queue depth (similar to iostat's aqu-sz), a distinct saturation symptom from raw disk busy-time utilization."
  },
  "stream_type": "metrics",
  "stream_name": "node_disk_io_time_weighted_seconds_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "rate(node_disk_io_time_weighted_seconds_total[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 10,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "10 is a rough default; acceptable queue depth depends on your storage backend (SSD/NVMe tolerate deeper queues than spinning disks) — adjust based on your hardware and workload."
}
