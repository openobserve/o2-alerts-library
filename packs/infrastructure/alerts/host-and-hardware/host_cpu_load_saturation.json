{
  "name": "host_cpu_load_saturation",
  "title": "Host CPU load saturation",
  "severity": "warning",
  "description": "Load average (1m) per CPU core is more than double the number of idle cores, meaning processes are queued waiting for CPU even if raw CPU utilization looks normal.",
  "tags": [
    "awesome-prometheus-alerts",
    "host-and-hardware",
