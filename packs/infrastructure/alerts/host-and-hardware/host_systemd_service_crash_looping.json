{
  "name": "host_systemd_service_crash_looping",
  "title": "Host systemd service crash looping",
  "severity": "warning",
  "description": "Systemd service has restarted more than twice in the last 5 minutes, indicating a crash loop that a simple 'failed' state check would miss because the service keeps restarting successfully.",
  "tags": [
    "awesome-prometheus-alerts",
    "host-and-hardware",
    "node-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/host-and-hardware/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/host-and-hardware/",
    "exporter": "node-exporter",
    "upstream_alert": "Host systemd service crash looping",
    "upstream_query": "increase(node_systemd_service_restart_total[5m]) > 2",
    "upstream_description": "Systemd service {{ $labels.name }} on {{ $labels.instance }} has restarted more than twice in the last 5 minutes, indicating a crash loop that a simple 'failed' state check would miss because the service keeps restarting successfully."
  },
  "stream_type": "metrics",
  "stream_name": "node_systemd_service_restart_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "increase(node_systemd_service_restart_total[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 2,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | name: {name} | instance: {instance} | value: {value}",
