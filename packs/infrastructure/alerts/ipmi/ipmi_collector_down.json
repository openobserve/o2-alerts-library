{
  "name": "ipmi_collector_down",
  "title": "IPMI collector down",
  "severity": "warning",
  "description": "IPMI collector failed to scrape sensor data. Check FreeIPMI tools and BMC connectivity.",
  "tags": [
    "awesome-prometheus-alerts",
    "ipmi",
    "ipmi-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/ipmi/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/basic-resource-monitoring/ipmi/",
    "exporter": "ipmi-exporter",
    "upstream_alert": "IPMI collector down",
    "upstream_query": "ipmi_up == 0",
    "upstream_description": "IPMI collector {{ $labels.collector }} on {{ $labels.instance }} failed to scrape sensor data. Check FreeIPMI tools and BMC connectivity."
  },
  "stream_type": "metrics",
  "stream_name": "ipmi_up",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "ipmi_up",
    "promql_condition": {
      "column": "value",
      "operator": "=",
      "value": 0,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | collector: {collector} | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "The ipmi_up metric is per-collector. A value of 0 means the collector could not retrieve data from the BMC."
}
