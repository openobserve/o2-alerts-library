{
  "name": "mysql_heartbeat_replication_lag",
  "title": "MySQL heartbeat replication lag",
  "severity": "critical",
  "description": "MySQL replication lag",
  "tags": [
    "awesome-prometheus-alerts",
    "mysql",
    "mysqld-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/mysql/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/mysql/",
    "exporter": "mysqld-exporter",
    "upstream_alert": "MySQL heartbeat replication lag",
    "upstream_query": "mysql_heartbeat_now_timestamp_seconds - mysql_heartbeat_stored_timestamp_seconds > 30",
    "upstream_description": "MySQL replication lag on {{ $labels.instance }}"
  },
  "stream_type": "metrics",
  "stream_name": "mysql_heartbeat_now_timestamp_seconds",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "mysql_heartbeat_now_timestamp_seconds - mysql_heartbeat_stored_timestamp_seconds",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 30,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "More reliable than seconds_behind_master since it measures actual wall-clock lag rather\nthan a value that can freeze during long-running statements. Requires mysqld_exporter's\noptional --collect.heartbeat flag and a pt-heartbeat-style heartbeat table."
}
