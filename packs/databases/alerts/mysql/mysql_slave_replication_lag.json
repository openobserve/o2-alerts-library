    "exporter": "mysqld-exporter",
    "upstream_alert": "MySQL Slave replication lag",
    "upstream_query": "( (mysql_slave_status_seconds_behind_master - mysql_slave_status_sql_delay) and ON (instance) mysql_slave_status_master_server_id > 0 ) > 30",
