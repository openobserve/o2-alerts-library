    "exporter": "mysqld-exporter",
    "upstream_alert": "MySQL High QPS",
    "upstream_query": "rate(mysql_global_status_questions[1m]) > 10000",
    "upstream_description": "MySQL is being overload with unusual QPS (> 10k QPS)."
  },
  "stream_type": "metrics",
  "stream_name": "mysql_global_status_questions",
  "is_real_time": false,
  "query_condition": {
