{
  "name": "elasticsearch_high_cpu_usage",
  "title": "Elasticsearch High CPU Usage",
  "severity": "warning",
  "description": "OS or Elasticsearch process CPU usage on node is above 90%, which can cause thread starvation, GC pressure, and slow queries.",
  "tags": [
    "awesome-prometheus-alerts",
    "elasticsearch",
    "prometheus-community-elasticsearch-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/elasticsearch/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/elasticsearch/",
    "exporter": "prometheus-community-elasticsearch-exporter",
    "upstream_alert": "Elasticsearch High CPU Usage",
    "upstream_query": "elasticsearch_os_cpu_percent > 90 or elasticsearch_process_cpu_percent > 90",
    "upstream_description": "OS or Elasticsearch process CPU usage on node {{ $labels.name }} is above 90% (current value: {{ $value }}%), which can cause thread starvation, GC pressure, and slow queries.",
    "query_normalized": "The upstream threshold could not be lifted out of the expression (its outermost operator is and/or/unless, or it compares against another series), so the expression is normalised to 1 per matching series and the alert fires on any match. The observed value in the notification is therefore always 1."
  },
  "stream_type": "metrics",
  "stream_name": "elasticsearch_os_cpu_percent",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "(elasticsearch_os_cpu_percent > 90 or elasticsearch_process_cpu_percent > 90) * 0 + 1",
    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | name: {name}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
