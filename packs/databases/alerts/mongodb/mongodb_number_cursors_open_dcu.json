    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/mongodb/",
    "exporter": "dcu-mongodb-exporter",
    "upstream_alert": "MongoDB number cursors open (DCU)",
    "upstream_query": "mongodb_metrics_cursor_open{state=\"total_open\"} > 10000",
    "upstream_description": "Too many cursors opened by MongoDB for clients (> 10k)"
  },
  "stream_type": "metrics",
  "stream_name": "mongodb_metrics_cursor_open",
  "is_real_time": false,
  "query_condition": {
