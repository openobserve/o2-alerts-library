{
  "name": "mongodb_number_cursors_open_dcu",
  "title": "MongoDB number cursors open (DCU)",
  "severity": "warning",
  "description": "Too many cursors opened by MongoDB for clients (> 10k)",
  "tags": [
    "awesome-prometheus-alerts",
    "dcu-mongodb-exporter",
    "mongodb"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/mongodb/",
  "source": {
