  "severity": "warning",
  "description": "Mongodb replication lag is more than 30s",
  "tags": [
    "awesome-prometheus-alerts",
    "mongodb",
    "percona-mongodb-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/mongodb/",
  "source": {
    "project": "awesome-prometheus-alerts",
