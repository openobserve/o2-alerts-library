  "severity": "critical",
  "description": "Postgresql seems to be processing very few transactions",
  "tags": [
    "awesome-prometheus-alerts",
    "postgres-exporter",
    "postgresql"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/postgresql/",
