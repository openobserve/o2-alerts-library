    "exporter": "postgres-exporter",
    "upstream_alert": "Postgresql commit rate low",
    "upstream_query": "increase(pg_stat_database_xact_commit{datname!~\"template.*|postgres\",datid!=\"0\"}[5m]) < 5",
    "upstream_description": "Postgresql seems to be processing very few transactions"
