{
  "name": "opensearch_high_bulk_rejection_rate",
  "title": "OpenSearch high bulk rejection rate",
  "severity": "warning",
  "description": "The ratio of rejected to completed bulk indexing requests on OpenSearch node is a high percentage, meaning the node cannot keep up with bulk indexing throughput.",
  "tags": [
    "awesome-prometheus-alerts",
    "opensearch",
    "opensearch-project-opensearch-prometheus-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/opensearch/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/opensearch/",
    "exporter": "opensearch-project-opensearch-prometheus-exporter",
    "upstream_alert": "OpenSearch high bulk rejection rate",
    "upstream_query": "round((rate(opensearch_threadpool_threads_count{name=\"bulk\",type=\"rejected\"}[5m]) / rate(opensearch_threadpool_threads_count{name=\"bulk\",type=\"completed\"}[5m])) * 100, 0.001) > 5",
    "upstream_description": "The ratio of rejected to completed bulk indexing requests on OpenSearch node {{ $labels.node }} is {{ $value }}%, meaning the node cannot keep up with bulk indexing throughput."
  },
  "stream_type": "metrics",
  "stream_name": "opensearch_threadpool_threads_count",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "round((rate(opensearch_threadpool_threads_count{name=\"bulk\",type=\"rejected\"}[5m]) / rate(opensearch_threadpool_threads_count{name=\"bulk\",type=\"completed\"}[5m])) * 100, 0.001)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 5,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | node: {node} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "5% rejection ratio is a rough default; depends on your indexing throughput relative to the configured bulk thread pool/queue size — adjust based on your workload."
}
