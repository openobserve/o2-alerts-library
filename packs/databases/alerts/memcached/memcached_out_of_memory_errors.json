{
  "name": "memcached_out_of_memory_errors",
  "title": "Memcached out of memory errors",
  "severity": "warning",
  "description": "Memcached is returning out-of-memory errors",
  "tags": [
    "awesome-prometheus-alerts",
    "memcached",
    "memcached-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/memcached/",
  "source": {
