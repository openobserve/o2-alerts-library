{
  "name": "memcached_items_too_large",
  "title": "Memcached items too large",
  "severity": "info",
  "description": "Memcached is rejecting items exceeding max-item-size",
  "tags": [
    "awesome-prometheus-alerts",
    "memcached",
    "memcached-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/memcached/",
  "source": {
