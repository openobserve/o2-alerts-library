    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/databases/memcached/",
    "exporter": "memcached-exporter",
    "upstream_alert": "Memcached items too large",
    "upstream_query": "increase(memcached_item_too_large_total[5m]) > 3",
    "upstream_description": "Memcached is rejecting items exceeding max-item-size on {{ $labels.instance }} ({{ $value }} rejections in the last 5m)"
  },
  "stream_type": "metrics",
  "stream_name": "memcached_item_too_large_total",
