{
  "name": "solr_high_jvm_heap_usage",
  "title": "Solr high JVM heap usage",
  "severity": "warning",
  "description": "Solr node is using more than 90% of its JVM heap, which can lead to node instability, stop-the-world GC pauses, or OutOfMemory crashes.",
