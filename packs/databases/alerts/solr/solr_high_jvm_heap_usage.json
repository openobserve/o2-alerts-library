    "exporter": "embedded-exporter",
    "upstream_alert": "Solr high JVM heap usage",
    "upstream_query": "sum by (base_url) (solr_metrics_jvm_memory_heap_bytes{item=\"used\"}) / sum by (base_url) (solr_metrics_jvm_memory_heap_bytes{item=\"max\"}) > 0.9",
