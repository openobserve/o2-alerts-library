{
  "name": "cilium_agent_bpf_map_pressure",
  "title": "Cilium agent BPF map pressure",
  "severity": "warning",
  "description": "Cilium agent eBPF map is above 90% utilization. Map may become full.",
  "tags": [
    "awesome-prometheus-alerts",
    "cilium",
    "embedded-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/network-and-security/cilium/",
  "source": {
    "project": "awesome-prometheus-alerts",
