    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/network-and-security/cilium/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Cilium agent BPF map pressure",
    "upstream_query": "cilium_bpf_map_pressure{} > 0.9",
    "upstream_description": "Cilium agent {{ $labels.pod }} eBPF map {{ $labels.map_name }} is above 90% utilization. Map may become full."
  },
  "stream_type": "metrics",
  "stream_name": "cilium_bpf_map_pressure",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "cilium_bpf_map_pressure{}",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.9,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | pod: {pod} | map_name: {map_name} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
