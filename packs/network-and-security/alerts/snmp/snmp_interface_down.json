{
  "name": "snmp_interface_down",
  "title": "SNMP interface down",
  "severity": "critical",
  "description": "Interface is operationally down while administratively up.",
  "tags": [
    "awesome-prometheus-alerts",
    "snmp",
    "snmp-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/network-and-security/snmp/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/network-and-security/snmp/",
    "exporter": "snmp-exporter",
    "upstream_alert": "SNMP interface down",
    "upstream_query": "(ifOperStatus{job=~\"snmp.*\"} == 2) and on(instance, job, ifIndex) (ifAdminStatus{job=~\"snmp.*\"} == 1)",
    "upstream_description": "Interface {{ $labels.ifDescr }} on {{ $labels.instance }} is operationally down while administratively up.",
    "query_normalized": "The upstream threshold could not be lifted out of the expression (its outermost operator is and/or/unless, or it compares against another series), so the expression is normalised to 1 per matching series and the alert fires on any match. The observed value in the notification is therefore always 1."
  },
  "stream_type": "metrics",
  "stream_name": "ifOperStatus",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "((ifOperStatus{job=~\"snmp.*\"} == 2) and on(instance, job, ifIndex) (ifAdminStatus{job=~\"snmp.*\"} == 1)) * 0 + 1",
    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | ifDescr: {ifDescr} | instance: {instance}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
