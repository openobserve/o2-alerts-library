    "sql": null,
    "promql": "(rate(ifInErrors{job=~\"snmp.*\"}[5m]) / (rate(ifHCInUcastPkts{job=~\"snmp.*\"}[5m]) + rate(ifHCInBroadcastPkts{job=~\"snmp.*\"}[5m]) + rate(ifHCInMulticastPkts{job=~\"snmp.*\"}[5m])) > 0.05 and (rate(ifHCInUcastPkts{job=~\"snmp.*\"}[5m]) + rate(ifHCInBroadcastPkts{job=~\"snmp.*\"}[5m]) + rate(ifHCInMulticastPkts{job=~\"snmp.*\"}[5m])) > 0) * 0 + 1",
    "promql_condition": {
