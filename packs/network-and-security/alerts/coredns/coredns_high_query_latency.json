{
  "name": "coredns_high_query_latency",
  "title": "CoreDNS High Query Latency",
  "severity": "critical",
  "description": "CoreDNS 99th percentile request duration on server zone is, indicating the resolver is overloaded or struggling to answer queries in time.",
  "tags": [
    "awesome-prometheus-alerts",
    "coredns",
    "embedded-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/network-and-security/coredns/",
  "source": {
    "project": "awesome-prometheus-alerts",
