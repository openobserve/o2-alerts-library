{
  "name": "php_fpm_listen_queue_saturation",
  "title": "PHP-FPM listen queue saturation",
  "severity": "warning",
  "description": "PHP-FPM listen queue is the socket backlog length, new connections may soon be queued or dropped.",
  "tags": [
    "awesome-prometheus-alerts",
    "bakins-fpm-exporter",
    "php-fpm"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/php-fpm/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/php-fpm/",
    "exporter": "bakins-fpm-exporter",
    "upstream_alert": "PHP-FPM listen queue saturation",
    "upstream_query": "sum(phpfpm_listen_queue_connections) by (instance) / sum(phpfpm_listen_queue_length_connections) by (instance) > 0.8",
    "upstream_description": "PHP-FPM listen queue on {{ $labels.instance }} is at {{ $value | humanizePercentage }} of the socket backlog length, new connections may soon be queued or dropped."
  },
  "stream_type": "metrics",
  "stream_name": "phpfpm_listen_queue_connections",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "sum(phpfpm_listen_queue_connections) by (instance) / sum(phpfpm_listen_queue_length_connections) by (instance)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.8,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | instance: {instance} | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
