{
  "name": "go_gc_cpu_fraction_high",
  "title": "Go GC CPU fraction high",
  "severity": "warning",
  "description": "Go GC is consuming too much CPU (> 5%)",
  "tags": [
    "awesome-prometheus-alerts",
    "golang",
    "golang-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/golang/",
  "source": {
    "project": "awesome-prometheus-alerts",
