    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/golang/",
    "exporter": "golang-exporter",
    "upstream_alert": "Go GC CPU fraction high",
    "upstream_query": "rate(go_gc_duration_seconds_sum[5m]) > 0.05",
    "upstream_description": "Go GC is consuming too much CPU (> 5%)"
  },
  "stream_type": "metrics",
  "stream_name": "go_gc_duration_seconds_sum",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "rate(go_gc_duration_seconds_sum[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0.05,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "rate(go_gc_duration_seconds_sum) approximates the fraction of wall-clock time spent in GC.\nThis replaces go_memstats_gc_cpu_fraction which was removed in client_golang v1.12+."
}
