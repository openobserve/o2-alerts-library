{
  "name": "go_goroutine_spike",
  "title": "Go goroutine spike",
  "severity": "warning",
  "description": "Go goroutine count is growing rapidly",
  "tags": [
    "awesome-prometheus-alerts",
    "golang",
    "golang-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/golang/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/golang/",
    "exporter": "golang-exporter",
    "upstream_alert": "Go goroutine spike",
    "upstream_query": "deriv(go_goroutines[5m]) > 10",
    "upstream_description": "Go goroutine count is growing rapidly ({{ $value | printf \"%.0f\" }} goroutines/s)"
  },
  "stream_type": "metrics",
  "stream_name": "go_goroutines",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "deriv(go_goroutines[5m])",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 10,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "A threshold of 100/s only catches catastrophic leaks (30k goroutines in 5m). 10/s catches gradual leaks (~3k in 5m).\nAdjust based on your application's expected concurrency patterns."
}
