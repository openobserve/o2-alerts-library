{
  "name": "go_memory_usage_high",
  "title": "Go memory usage high",
  "severity": "warning",
  "description": "Go heap allocation is using most of the runtime's reserved memory (> 90%), indicating the process may need more memory or has a leak",
  "tags": [
    "awesome-prometheus-alerts",
    "golang",
    "golang-exporter"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/golang/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/runtimes/golang/",
    "exporter": "golang-exporter",
    "upstream_alert": "Go memory usage high",
    "upstream_query": "(go_memstats_heap_alloc_bytes / go_memstats_sys_bytes) * 100 > 90",
    "upstream_description": "Go heap allocation is using most of the runtime's reserved memory (> 90%), indicating the process may need more memory or has a leak"
  },
  "stream_type": "metrics",
  "stream_name": "go_memstats_heap_alloc_bytes",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "(go_memstats_heap_alloc_bytes / go_memstats_sys_bytes) * 100",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 90,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "context_attributes": {},
  "row_template": "*{alert_name}* | value: {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "notes": "go_memstats_sys_bytes is the total memory obtained from the OS by the Go runtime, not total host memory.\nThis ratio measures Go-internal memory utilization, not system-level memory pressure."
}
