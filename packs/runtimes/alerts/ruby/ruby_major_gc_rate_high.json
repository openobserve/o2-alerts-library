    "exporter": "ruby-exporter",
    "upstream_alert": "Ruby major GC rate high",
    "upstream_query": "rate(ruby_major_gc_ops_total[5m]) > 2",
    "upstream_description": "Ruby is performing too many major GC cycles, indicating memory pressure"
